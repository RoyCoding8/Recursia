# === LLM Provider (required) ===
# Options: gemini, groq, bedrock, stub
LLM_PROVIDER=bedrock

# === AWS Bedrock (primary) ===
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from env or IAM role
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# === Alternative: Gemini ===
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# === Alternative: Groq ===
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# === Model overrides ===
# LLM_MODEL=   # override provider default
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# === Database ===
# Local dev: sqlite:///recursia.db
# Docker: postgresql://recursia:password@db:5432/recursia
DATABASE_URL=sqlite:///recursia.db

# === Sandbox (execution-based verification) ===
# true = run code against auto-generated tests; false = LLM-only checker
SANDBOX_ENABLED=true
# Backend: "local" = subprocess (dev), "docker" = epicbox containers (production)
# SANDBOX_BACKEND=local

# === Env precedence ===
BACKEND_ENV_PRECEDENCE=os_wins
